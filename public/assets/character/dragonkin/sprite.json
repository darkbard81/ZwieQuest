  "naturalnessReview": {
    "Front_Idle": {
      "verdict": "주의: 경계 접촉",
      "notes": "호흡과 날개 펼침·접힘, 꼬리 움직임이 이어진다. 발과 뿔이 화면 상하단에 닿고 날개를 펼치는 구간은 끝이 좌우 경계에 닿는다. 꼬리 실루엣이 변한다."
    },
    "Front_Victory": {
      "verdict": "동작 흐름 양호, 날개 끝 잘림",
      "notes": "팔 올림→미소와 날개 펼침→팔 내림과 자세 복귀가 읽힌다. 크게 펼친 날개 끝이 화면 밖으로 잘린다. 중간 몸 높이와 꼬리 형태 변화가 있다."
    },
    "Side_Walk": {
      "verdict": "보행 흐름 확인, 경계·외형 변화 주의",
      "notes": "발 교대와 팔 흔들림이 이어진다. 꼬리가 왼쪽 경계를 넘는 구간과 발의 하단 접촉이 있다. 소매·신발 형태와 가장자리 색이 변하고 반복 연결에서 꼬리 모양 차이가 보인다."
    },
    "Side_Attack": {
      "verdict": "공격·회복 확인, 속도·방향 주의",
      "notes": "팔을 당겨 준비한 뒤 앞으로 휘두르고 회복한다. 공격 중 몸이 3/4 방향으로 돌아오고 머리카락과 소매가 크게 변한다. 원본 5초 구간을 게임의 650ms로 표시하므로 빠른 전환이 두드러질 수 있다. 발과 머리카락의 경계 접촉이 있다."
    },
    "Side_Down": {
      "verdict": "쓰러짐 흐름 양호, 끝부분 잘림",
      "notes": "무릎이 굽혀지고 몸이 내려가 옆으로 눕는 순서와 최종 자세가 명확하다. 머리카락과 발끝이 좌우 경계에 걸린다. 쓰러지며 날개·꼬리 형태 및 끝 색이 달라진다."
    },
    "Side_Hit": {
      "verdict": "부적합 요소 있음: 시점·날개 변형",
      "notes": "피격 반응 중 측면에서 정면으로 돌아서고 날개가 커지며 형태가 변한다. 이후 돌아오지만 원래 날개 형태와 완전히 같지 않다. 날개·꼬리 잘림이 있고 360ms 재생에서 변화가 급하다. 비교용 적용 결과로 보존한다."
    }
  }
}
